<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xcore_sim</name>
  <version>0.0.0</version>
  <description>Simulation launch wiring for xCore arm teleoperation.</description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>Apache-2.0</license>

  <!-- C++ simulation adapter package: ArmServoCommand -> MoveIt/ros2_control. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rokae_hardware</exec_depend>
  <exec_depend>rokae_description</exec_depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>
  <depend>vr_robot_interfaces</depend>
  <exec_depend>teleop_core</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
